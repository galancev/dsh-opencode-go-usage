{
  "name": "@galancev/dsh-opencode-go-usage",
  "version": "1.6.1",
  "description": "DSH (DeepSeek Harness) plugin: OpenCode GO plan quota GO button in the composer dock with a hover/click popover, same-origin usage proxy, and a /opencode-go chat command (DSH 0.1.7+ and 0.2.0 compatible)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.ru.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "opencode",
    "opencode-go",
    "usage",
    "quota",
    "plugin",
    "cordis"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "@deepseek-ai/dsh": ">=0.1.7-rc.1 <0.3.0"
  },
  "license": "MIT",
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "node --test test/client.test.mjs"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": "github:galancev/dsh-opencode-go-usage",
  "homepage": "https://github.com/galancev/dsh-opencode-go-usage#readme",
  "bugs": {
    "url": "https://github.com/galancev/dsh-opencode-go-usage/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
